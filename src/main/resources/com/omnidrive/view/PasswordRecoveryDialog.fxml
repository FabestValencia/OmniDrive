<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.omnidrive.controller.PasswordRecoveryController"
      stylesheets="@styles.css" styleClass="card" spacing="16" prefWidth="440">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24"/>
    </padding>

    <!-- Encabezado -->
    <VBox spacing="4" styleClass="card-header">
        <Label text="Recuperación de Contraseña" styleClass="title-medium" style="-fx-text-fill: #1e40af;"/>
        <Label text="Ingresa tu usuario o correo para recibir el código de verificación de 15 minutos."
               wrapText="true" styleClass="subtitle-text"/>
    </VBox>

    <!-- Paso 1: Solicitud de Código -->
    <VBox fx:id="step1Box" spacing="14">
        <VBox spacing="6">
            <Label text="Usuario o Correo Registrado" styleClass="label-bold"/>
            <TextField fx:id="identifierField" promptText="admin@omnidrive.com o usuario"/>
        </VBox>

        <Button fx:id="requestButton" text="Enviar Código de Verificación"
                onAction="#handleRequestCode" maxWidth="Infinity" styleClass="button-primary"/>
    </VBox>

    <!-- Paso 2: Verificación y Cambio de Clave -->
    <VBox fx:id="step2Box" spacing="14">
        <VBox spacing="6">
            <Label text="Código de Verificación (6 dígitos)" styleClass="label-bold"/>
            <TextField fx:id="codeField" promptText="Ej. 123456"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Nueva Contraseña" styleClass="label-bold"/>
            <PasswordField fx:id="newPasswordField" promptText="Al menos 8 caracteres con mayúscula, número y símbolo"/>
        </VBox>

        <VBox spacing="6">
            <Label text="Confirmar Nueva Contraseña" styleClass="label-bold"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repite la nueva contraseña"/>
        </VBox>

        <Button fx:id="resetButton" text="Restablecer Contraseña"
                onAction="#handleResetPassword" maxWidth="Infinity" styleClass="button-success"/>
    </VBox>

    <!-- Mensaje de Estado / Error -->
    <Label fx:id="messageLabel" wrapText="true" text=""/>

    <!-- Acciones Inferiores -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="cancelButton" text="Cerrar" onAction="#handleCancel" styleClass="button-secondary"/>
    </HBox>
</VBox>
