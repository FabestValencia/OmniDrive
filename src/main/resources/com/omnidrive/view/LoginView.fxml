<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.omnidrive.controller.LoginController"
           styleClass="root" stylesheets="@styles.css" prefWidth="900" prefHeight="650">

    <VBox alignment="CENTER" spacing="0" maxWidth="420" maxHeight="500" styleClass="card">
        <padding>
            <Insets top="36" right="36" bottom="36" left="36"/>
        </padding>

        <!-- Cabecera de la Marca -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="OmniDrive" styleClass="title-large" style="-fx-font-size: 28px; -fx-text-fill: #1e40af;"/>
            <Label text="Sistema de Información de Concesionario" styleClass="subtitle-text"/>
        </VBox>

        <VBox spacing="18" alignment="CENTER_LEFT">
            <VBox.margin>
                <Insets top="30" bottom="10"/>
            </VBox.margin>

            <!-- Campo Usuario -->
            <VBox spacing="6">
                <Label text="Nombre de Usuario o Cédula" styleClass="label-bold"/>
                <TextField fx:id="usernameField" promptText="Ej. admin o usuario"/>
            </VBox>

            <!-- Campo Contraseña -->
            <VBox spacing="6">
                <Label text="Contraseña" styleClass="label-bold"/>
                <PasswordField fx:id="passwordField" promptText="••••••••"/>
            </VBox>

            <!-- Mensaje de Error Dinámico -->
            <Label fx:id="errorLabel" text="" wrapText="true"
                   style="-fx-text-fill: #dc2626; -fx-font-weight: bold; -fx-font-size: 12px;"/>

            <!-- Botón de Inicio de Sesión -->
            <Button fx:id="loginButton" text="Iniciar Sesión" onAction="#handleLogin"
                    defaultButton="true" maxWidth="Infinity" styleClass="button-primary"/>

            <!-- Enlace Recuperación de Contraseña -->
            <VBox alignment="CENTER">
                <Hyperlink fx:id="forgotPasswordLink" text="¿Olvidaste tu contraseña?"
                           onAction="#handleForgotPassword"
                           style="-fx-text-fill: #1e40af; -fx-font-size: 12px;"/>
            </VBox>
        </VBox>
    </VBox>
</StackPane>
