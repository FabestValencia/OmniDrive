<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnidrive.controller.CustomerManagementController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f8fafc;"
            stylesheets="@styles.css">

    <content>
        <VBox spacing="20.0" style="-fx-padding: 10px;">
            <!-- Encabezado de Sección -->
            <VBox spacing="4.0">
                <Label text="Gestión de Clientes" styleClass="title-large" />
                <Label text="Directorio de clientes, registro de compradores y arrendatarios con validación RFC."
                       styleClass="subtitle-text" />
            </VBox>

            <!-- Disposición Horizontal: Tabla a la izquierda, Formulario a la derecha -->
            <HBox spacing="20.0" alignment="TOP_LEFT">
                <!-- Columna Izquierda: Búsqueda y Tabla -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <!-- Barra de Búsqueda -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <TextField fx:id="txtSearch" promptText="🔍 Buscar por cédula, nombre o correo..."
                                   HBox.hgrow="ALWAYS" styleClass="text-field" />
                    </HBox>

                    <!-- Tabla de Clientes -->
                    <TableView fx:id="customerTable" prefHeight="480.0" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colId" text="Cédula / Identificación" prefWidth="130.0" />
                            <TableColumn fx:id="colFullName" text="Nombre Completo" prefWidth="190.0" />
                            <TableColumn fx:id="colPhone" text="Teléfono" prefWidth="120.0" />
                            <TableColumn fx:id="colEmail" text="Correo Electrónico" prefWidth="220.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Columna Derecha: Tarjeta de Formulario de Cliente -->
                <VBox spacing="14.0" styleClass="card" prefWidth="350.0" minWidth="330.0">
                    <Label text="Ficha del Cliente" styleClass="title-small" />

                    <!-- Campo Cédula -->
                    <VBox spacing="4.0">
                        <Label text="Cédula / Identificación" styleClass="label-bold" />
                        <TextField fx:id="txtId" promptText="Ej: 1094888999" styleClass="text-field" />
                    </VBox>

                    <!-- Nombres y Apellidos -->
                    <HBox spacing="10.0">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Nombres" styleClass="label-bold" />
                            <TextField fx:id="txtFirstName" promptText="Nombres" styleClass="text-field" />
                        </VBox>
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label text="Apellidos" styleClass="label-bold" />
                            <TextField fx:id="txtLastName" promptText="Apellidos" styleClass="text-field" />
                        </VBox>
                    </HBox>

                    <!-- Teléfono -->
                    <VBox spacing="4.0">
                        <Label text="Teléfono de Contacto" styleClass="label-bold" />
                        <TextField fx:id="txtPhone" promptText="Ej: 3001234567" styleClass="text-field" />
                    </VBox>

                    <!-- Correo Electrónico -->
                    <VBox spacing="4.0">
                        <Label text="Correo Electrónico (Formato RFC)" styleClass="label-bold" />
                        <TextField fx:id="txtEmail" promptText="cliente@ejemplo.com" styleClass="text-field" />
                    </VBox>

                    <Region prefHeight="8.0" />

                    <!-- Botones de Acción -->
                    <HBox spacing="10.0">
                        <Button fx:id="btnRegister" text="Registrar Cliente" onAction="#handleRegister"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="button-primary" />
                        <Button fx:id="btnUpdate" text="Actualizar" onAction="#handleUpdate"
                                maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="button-primary" />
                    </HBox>

                    <Button fx:id="btnClear" text="Limpiar Formulario" onAction="#handleClear"
                            maxWidth="Infinity" styleClass="button-secondary" />
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
