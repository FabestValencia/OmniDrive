<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnidrive.controller.VehicleManagementController"
            fitToWidth="true" style="-fx-background-color: transparent; -fx-background: #f8fafc;"
            stylesheets="@styles.css">

    <content>
        <VBox spacing="20.0" style="-fx-padding: 10px;">
            <!-- Encabezado con Botón de Alta -->
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                    <Label text="Inventario de Vehículos" styleClass="title-large" />
                    <Label text="Catálogo general, especificaciones técnicas y disponibilidad para venta o arriendo."
                           styleClass="subtitle-text" />
                </VBox>
                <Button fx:id="btnNewVehicle" text="+ Registrar Vehículo" onAction="#handleNewVehicle"
                        styleClass="button-primary" />
            </HBox>

            <!-- Disposición Horizontal: Tabla a la izquierda, Ficha técnica a la derecha -->
            <HBox spacing="20.0" alignment="TOP_LEFT">
                <!-- Columna Izquierda: Filtros y Tabla -->
                <VBox spacing="12.0" HBox.hgrow="ALWAYS">
                    <!-- Barra de Búsqueda y Filtros Combinados -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <TextField fx:id="txtSearch" promptText="🔍 Buscar por placa, marca o tipo..."
                                   HBox.hgrow="ALWAYS" styleClass="text-field" />
                        <ComboBox fx:id="cmbConditionFilter" prefWidth="180.0" styleClass="combo-box" />
                        <ComboBox fx:id="cmbStatusFilter" prefWidth="200.0" styleClass="combo-box" />
                    </HBox>

                    <!-- Tabla de Vehículos -->
                    <TableView fx:id="vehicleTable" prefHeight="500.0" VBox.vgrow="ALWAYS" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="colPlate" text="Placa" prefWidth="95.0" />
                            <TableColumn fx:id="colBrand" text="Marca" prefWidth="130.0" />
                            <TableColumn fx:id="colType" text="Tipo" prefWidth="110.0" />
                            <TableColumn fx:id="colModelYear" text="Año" prefWidth="65.0" />
                            <TableColumn fx:id="colFuelType" text="Combustible" prefWidth="95.0" />
                            <TableColumn fx:id="colCondition" text="Condición" prefWidth="85.0" />
                            <TableColumn fx:id="colStatus" text="Estado" prefWidth="135.0" />
                            <TableColumn fx:id="colBasePrice" text="Precio Base" prefWidth="115.0" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Columna Derecha: Panel Lateral Sincronizado (Ficha Técnica y Foto) -->
                <VBox fx:id="detailPanel" spacing="12.0" styleClass="card" prefWidth="350.0" minWidth="330.0">
                    <Label text="Ficha Técnica Sincronizada" styleClass="title-small" />

                    <!-- Fotografía del Vehículo con Fallback Elegante -->
                    <VBox alignment="CENTER" prefHeight="170.0" style="-fx-background-color: #f1f5f9; -fx-background-radius: 8px;">
                        <ImageView fx:id="imgVehiclePhoto" fitHeight="160.0" fitWidth="300.0" preserveRatio="true" />
                    </VBox>

                    <!-- Identificación Básica y Badge -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <VBox HBox.hgrow="ALWAYS">
                            <Label fx:id="lblDetailPlate" text="---" styleClass="title-medium" />
                            <Label fx:id="lblDetailBrand" text="Seleccione un vehículo" styleClass="subtitle-text" />
                        </VBox>
                        <Label fx:id="lblDetailType" text="---" styleClass="user-badge" />
                    </HBox>

                    <!-- Estado y Precio -->
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="lblDetailStatus" text="---" styleClass="label-bold" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblDetailPrice" text="---" styleClass="title-small" style="-fx-text-fill: #1e40af;" />
                    </HBox>

                    <!-- Especificaciones Detalladas -->
                    <Label text="Especificaciones del Fabricante" styleClass="label-bold" />
                    <ScrollPane fitToWidth="true" prefHeight="220.0"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <content>
                            <Label fx:id="lblDetailTechnicalSpecs" text="Seleccione una fila en la tabla para inspeccionar."
                                   wrapText="true" styleClass="subtitle-text" style="-fx-line-spacing: 3px;" />
                        </content>
                    </ScrollPane>
                </VBox>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
