<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.omnidrive.controller.MainLayoutController"
            prefHeight="720.0" prefWidth="1100.0"
            stylesheets="@styles.css">

    <!-- BARRA LATERAL (SIDEBAR DE NAVEGACIÓN) -->
    <left>
        <VBox prefWidth="250.0" spacing="6.0" styleClass="sidebar">
            <!-- Encabezado y Marca -->
            <VBox spacing="4.0" styleClass="sidebar-brand-box">
                <Label text="OmniDrive" styleClass="sidebar-brand-text" />
                <Label text="Gestión de Concesionario" styleClass="subtitle-text" />
            </VBox>

            <!-- Sección Principal -->
            <Label text="PRINCIPAL" styleClass="sidebar-category-label" />
            <Button fx:id="btnDashboard" text="🏠  Panel Principal" onAction="#showDashboard"
                    maxWidth="Infinity" styleClass="nav-button, active" />

            <!-- Sección Operaciones -->
            <Label text="CATÁLOGO Y CLIENTES" styleClass="sidebar-category-label" />
            <Button fx:id="btnVehicles" text="🚗  Vehículos" onAction="#showVehicles"
                    maxWidth="Infinity" styleClass="nav-button" />
            <Button fx:id="btnCustomers" text="👥  Clientes" onAction="#showCustomers"
                    maxWidth="Infinity" styleClass="nav-button" />
            <Button fx:id="btnTransactions" text="💼  Transacciones" onAction="#showTransactions"
                    maxWidth="Infinity" styleClass="nav-button" />

            <!-- Sección Administración (Solo Admin) -->
            <Label text="ADMINISTRACIÓN" styleClass="sidebar-category-label" />
            <Button fx:id="btnEmployees" text="👔  Empleados" onAction="#showEmployees"
                    maxWidth="Infinity" styleClass="nav-button" />
            <Button fx:id="btnReports" text="📊  Reportes" onAction="#showReports"
                    maxWidth="Infinity" styleClass="nav-button" />

            <!-- Espaciador Flexible -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Cerrar Sesión -->
            <Button fx:id="btnLogout" text="🚪  Cerrar Sesión" onAction="#handleLogout"
                    maxWidth="Infinity" styleClass="nav-button" />
        </VBox>
    </left>

    <!-- BARRA SUPERIOR (TOPBAR CON SESIÓN ACTIVA) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="topbar">
            <Label fx:id="lblSectionTitle" text="Panel Principal" styleClass="title-medium" />

            <Region HBox.hgrow="ALWAYS" />

            <HBox alignment="CENTER_RIGHT" spacing="12.0">
                <Label fx:id="lblUserName" text="Usuario" styleClass="label-bold" />
                <Label fx:id="lblUserRole" text="Administrador" styleClass="user-badge" />
            </HBox>
        </HBox>
    </top>

    <!-- ÁREA DE CONTENIDO DINÁMICA -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 24px; -fx-background-color: #f8fafc;" />
    </center>

</BorderPane>
